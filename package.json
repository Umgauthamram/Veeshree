{
  "name": "veeshree",
  "version": "1.0.0-rc.1",
  "description": "Local-first, model-independent architectural context persistence layer for AI software development",
  "type": "module",
  "bin": {
    "vee": "./bin/vee.js",
    "veeshree": "./bin/vee.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "models.json",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Umgauthamram/veeshree"
  },
  "homepage": "https://github.com/Umgauthamram/veeshree#readme",
  "bugs": {
    "url": "https://github.com/Umgauthamram/veeshree/issues"
  },
  "scripts": {
    "sync:models": "node -e \"require('fs').copyFileSync('models.json', 'src/models.json')\"",
    "check:catches": "node -e \"const fs=require('fs'),path=require('path');function walk(d){let r=[];for(const f of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,f.name);if(f.isDirectory())r.push(...walk(p));else if(f.name.endsWith('.ts'))r.push(p);}return r;}let c=0;for(const f of walk('src')){const m=fs.readFileSync(f,'utf-8').matchAll(/catch(?:\\s*\\([^)]*\\))?\\s*\\{([^}]*)\\}/g);for(const match of m){const b=match[1].replace(/\\/\\/[^\\n]*/g,'').replace(/\\/\\*[\\s\\S]*?\\*\\//g,'').trim();if(b.length===0){console.error('Silent catch in '+f);c++;}}}if(c>0)process.exit(1);\"",
    "build": "npm run sync:models && tsup",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm run build && npm test",
    "dev": "tsup --watch",
    "test": "npm run sync:models && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run sync:models && vitest run --coverage"
  },
  "publishConfig": {
    "provenance": true
  },
  "keywords": [
    "ai",
    "context",
    "memory",
    "cli",
    "llm",
    "adr",
    "mcp",
    "developer-tools",
    "local-first"
  ],
  "author": "Gautham Ram",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^12.1.0",
    "jsonc-parser": "^3.3.1",
    "minisearch": "^7.1.0",
    "picocolors": "^1.1.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsup": "^8.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
